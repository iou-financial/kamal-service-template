#!/bin/sh
# Fetch a secret from AWS Secrets Manager for use in a Kamal secrets file.
#
# Kamal parses .kamal/secrets* with dotenv. Kamal replaces only dotenv's
# Command substitution (Kamal::Secrets::Dotenv::InlineCommandSubstitution),
# leaving the chain:
#
#   InlineCommandSubstitution -> Dotenv::Substitutions::Variable
#
# The fetch runs in pass one and returns the real secret; pass two then reads
# that returned secret looking for "$VAR" and replaces anything it finds with
# the empty string. A secret containing "$" is therefore delivered TRUNCATED,
# with no error and no log line anywhere, and "${HOME}" would expand to the
# deployer's home directory. See DEVOPS-379.
#
# dotenv's Variable regex is:  (\\)?(\$)(?!\()
#
# so we escape exactly what it would consume -- every "$" EXCEPT one followed
# by "(", which that lookahead already ignores. Escaping "$(" too would leave
# a stray backslash, since the lookahead stops Variable from unescaping it.
# perl is used for the lookahead; sed cannot express it, and a non-overlapping
# sed workaround corrupts consecutive "$$".
#
# Secrets with no "$" pass through byte-identical.
#
# NOTE: .kamal/hooks/* do NOT need this -- Kamal executes hooks directly as
# programs, so dotenv never parses them.
#
# NOTE: this script cannot abort a deploy. Kamal runs it inside Ruby backticks,
# where the exit status is discarded, so a failed fetch would otherwise be
# deployed as an empty string. .kamal/hooks/pre-connect is the guard that can
# actually fail the deploy -- hook exit status IS honoured.
set -eu

if [ $# -ne 1 ] || [ -z "$1" ]; then
  echo "fetch-secret: usage: fetch-secret <secret-id>" >&2
  exit 1
fi

value=$(aws secretsmanager get-secret-value \
          --secret-id "$1" \
          --query SecretString \
          --output text \
          --region us-east-1) \
  || { echo "fetch-secret: AWS fetch failed for '$1'" >&2; exit 1; }

if [ -z "$value" ] || [ "$value" = "None" ]; then
  echo "fetch-secret: empty secret for '$1'" >&2
  exit 1
fi

printf '%s' "$value" | perl -pe 's/\$(?!\()/\\\$/g'
