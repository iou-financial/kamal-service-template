#!/bin/sh
# Fetch a secret from AWS Secrets Manager for use in a Kamal secrets file.
#
# Kamal parses .kamal/secrets* with dotenv, which runs its Command
# substitution and THEN its Variable substitution over the SAME value
# (Dotenv::Parser.substitutions). So a "$" that comes back inside a fetched
# secret is re-read as a variable reference on the second pass: "$a" and
# "$bc" resolve to nothing and are silently dropped, and the app boots with a
# truncated credential and no error anywhere.
#
# Escaping each "$" on the way out makes dotenv's Variable pass unescape it
# back to a literal "$" instead of expanding it. Secrets with no "$" are
# unaffected.
#
# Do NOT inline the aws call in .kamal/secrets.staging: dotenv's
# unescape_characters strips a backslash from the line before the command
# runs, turning the sed escape into a no-op. It has to live in a separate
# file like this one.
#
# NOTE: .kamal/hooks/* do NOT need this -- Kamal executes hooks directly as
# programs, so dotenv never parses them.
set -e

aws secretsmanager get-secret-value \
  --secret-id "$1" \
  --query SecretString \
  --output text \
  --region us-east-1 \
  | sed 's/\$/\\$/g'
